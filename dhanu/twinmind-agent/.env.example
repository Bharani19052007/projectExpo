# TwinMind Agent — Example Configuration
# Copy this file to .env and fill in the values,
# OR let the setup wizard populate it automatically.
# NEVER commit your real .env file to source control.

# Full URL to the TwinMind server on Laptop A
# Example: http://192.168.1.10:8000
SERVER_URL=

# Unique device identifier (auto-generated on first run)
# Example: TWIN-LAPTOP-A7F42
DEVICE_ID=

# Human-readable name for this device
# Example: Engineering-Laptop-01
DEVICE_NAME=

# Telemetry push interval in seconds (1–10 recommended)
TELEMETRY_INTERVAL=2

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
