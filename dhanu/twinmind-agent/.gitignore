# TwinMind Agent — .gitignore

# ── Secrets (never commit these) ──────────────────────────────────────────────
.env
agent_state.json

# ── Local data ────────────────────────────────────────────────────────────────
buffer.db
buffer.db-shm
buffer.db-wal
logs/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
